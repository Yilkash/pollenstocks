# Copy to .env.local. Never put wallet private keys in this app.
APP_ORIGIN=http://localhost:3000
APP_CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Deploy MockPaymentUSD using the repository's Foundry script, then paste its address.
DEMO_TOKEN_ADDRESS=
DATABASE_PATH=.data/steward.sqlite
# Required only for SERV chat. The manual payment flow works without it.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# WhatsApp intent/conversation upgrade; the web demo keeps SERV_MODEL.
WHATSAPP_SERV_MODEL=gpt-5.4
WHATSAPP_SERV_REASONING_EFFORT=medium
# Public-result wording uses the smaller model without extra reasoning.
WHATSAPP_SERV_WORDING_MODEL=gpt-5.4-mini
# Local integration: APP_CHAIN_ID=31337, RPC_URL=http://127.0.0.1:8545

# WhatsApp transport: disabled until private credentials and allowed testers are configured.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# 32 random bytes encoded as 64 hex characters; keep stable with this database.
WHATSAPP_DATA_KEY=
# Keep allowlist while using the Meta test number. Set public after production onboarding.
WHATSAPP_ACCESS_MODE=allowlist
# Comma-separated WhatsApp sender IDs: required in allowlist mode; optional in public mode.
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_DATABASE_PATH=.data/whatsapp.sqlite

# Managed wallet candidate; do not enable creation until compatibility/policies are proven.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_OWNER_ID=
PRIVY_WALLET_POLICY_ID=
PRIVY_WALLET_CREATION_ENABLED=false

# Arc mainnet (5042) stock trading. Quotes use public KyberSwap routes (no API key); fair
# prices use Robinhood's public token bid/ask (no key). USDC is also the gas token on Arc.
MAINNET_STOCK_TRADING_ENABLED=false
# KyberSwap executor and bytecode pins on Arc, read from chain 5042 on 2026-10-04.
# The same addresses exist on other chains with different bytecode; never reuse other pins.
MAINNET_KYBER_EXECUTOR=0x8F10B468b06c6FD214B65F87778827F7D113f996
MAINNET_KYBER_EXECUTOR_CODEHASH=0x738f9b12983256e24b7ec81a7bf5a3f4fd1328a926beef4aa6a6a0d56d09e307
MAINNET_ROUTER_CODEHASH=0xcfc4b72d96b3a4da0e5bd31270b05a8958367adc456845ebd74e5c15f4807399
# Created by scripts/mainnet-policy-create.ts from the generated Arc policy.
PRIVY_MAINNET_POLICY_ID=
# Per-trade ceiling in USDC (up to 1000).
MAINNET_MAX_USDC_PER_TRADE=
# Optional fee ceiling in native USDC units (18 decimals), at most 0.1 USDC. Leave empty
# for automatic fees approved per trade.
MAINNET_MAX_FEE_WEI=
