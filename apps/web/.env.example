# Copy to .env.local. Never put wallet private keys in this app.
APP_ORIGIN=http://localhost:3000
APP_CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Deploy MockPaymentUSD using the repository's Foundry script, then paste its address.
DEMO_TOKEN_ADDRESS=
DATABASE_PATH=.data/steward.sqlite
# Required only for SERV chat. The manual payment flow works without it.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# Local integration: APP_CHAIN_ID=31337, RPC_URL=http://127.0.0.1:8545

# WhatsApp transport: disabled until private credentials and allowed testers are configured.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# 32 random bytes encoded as 64 hex characters; keep stable with this database.
WHATSAPP_DATA_KEY=
# Comma-separated WhatsApp sender IDs: country code and digits, no plus/spaces.
WHATSAPP_ALLOWED_SENDERS=
WHATSAPP_DATABASE_PATH=.data/whatsapp.sqlite

# Managed wallet candidate; do not enable creation until compatibility/policies are proven.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_OWNER_ID=
PRIVY_WALLET_POLICY_ID=
PRIVY_WALLET_CREATION_ENABLED=false
